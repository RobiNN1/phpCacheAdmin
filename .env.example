# phpCacheAdmin environment configuration
#
# Copy this file to ".env" and adjust the values.
# Loading it requires vlucas/phpdotenv: composer require vlucas/phpdotenv
#
# Every key from config.dist.php is available as an environment variable, just
# prefix it with PCA_ and write it in UPPER_CASE.
# Array options use "_" e.g., PCA_REDIS_0_HOST, and values may also be JSON.

# === Dashboards ===
# Enabled dashboards and their order. The first item is the default dashboard.
PCA_DASHBOARDS=["RobiNN\\Pca\\Dashboards\\Server\\ServerDashboard","RobiNN\\Pca\\Dashboards\\Redis\\RedisDashboard","RobiNN\\Pca\\Dashboards\\Memcached\\MemcachedDashboard","RobiNN\\Pca\\Dashboards\\OPCache\\OPCacheDashboard","RobiNN\\Pca\\Dashboards\\APCu\\APCuDashboard","RobiNN\\Pca\\Dashboards\\Realpath\\RealpathDashboard"]

# === Redis ===
# redis or predis. Auto-detected when not set.
#PCA_REDISOPTIONS_CLIENT=predis
# Extra commands to refuse in the console, as a JSON array.
#PCA_REDISOPTIONS_BLOCKEDCOMMANDS=["CONFIG SET","CONFIG REWRITE","REPLICAOF","SLAVEOF","MIGRATE","RESTORE","SAVE"]
# Refresh interval for the Pub/Sub active channels list, in seconds.
PCA_REDISOPTIONS_PUBSUBREFRESH=5
# How long one Pub/Sub monitor request captures messages, in seconds (1-10).
PCA_REDISOPTIONS_PUBSUBWINDOW=5
# Use SCAN automatically instead of KEYS when the database has more keys than this.
PCA_REDISOPTIONS_SCANTHRESHOLD=100000
# Always use SCAN and retrieve at most this many keys, regardless of the threshold (optional).
#PCA_REDISOPTIONS_SCANSIZE=1000

# Server 0, increase the index for more servers.
PCA_REDIS_0_NAME=Localhost
PCA_REDIS_0_HOST=127.0.0.1
PCA_REDIS_0_PORT=6379
# Cluster nodes as a JSON array (optional, replaces host/port).
#PCA_REDIS_0_NODES=["127.0.0.1:7000","127.0.0.1:7001","127.0.0.1:7002"]
# List of Sentinels. Replaces the host/port when set, the master is looked up on every request.
#PCA_REDIS_0_SENTINELS=["127.0.0.1:26379","127.0.0.1:26380","127.0.0.1:26381"]
# Name of the monitored master, default mymaster.
#PCA_REDIS_0_SENTINELMASTER=mymaster
# Password of the Sentinels themselves, not of the master.
#PCA_REDIS_0_SENTINELPASSWORD=
# Connection scheme, set to "tls" for an encrypted connection (optional).
#PCA_REDIS_0_SCHEME=tls
# SSL/TLS options as JSON, requires Redis >= 6.0 (optional).
#PCA_REDIS_0_SSL={"cafile":"private.pem","verify_peer":true}
# Default database (optional).
#PCA_REDIS_0_DATABASE=0
# ACL credentials, require Redis >= 6.0 (optional).
#PCA_REDIS_0_USERNAME=
#PCA_REDIS_0_PASSWORD=
# File with a password, e.g., Docker secrets (optional).
#PCA_REDIS_0_AUTHFILE=/run/secrets/redis_password
# Unix domain socket (optional, replaces host/port).
#PCA_REDIS_0_PATH=/var/run/redis/redis-server.sock
# Number of databases, use this if the CONFIG command is disabled (optional).
#PCA_REDIS_0_DATABASES=16
# Separator for the tree view (optional).
#PCA_REDIS_0_SEPARATOR=:

# === Memcached ===
# Extra commands to refuse in the console, as a JSON array. The case does not matter.
#PCA_MEMCACHEDOPTIONS_BLOCKEDCOMMANDS=["flush_all","stats reset"]

# Server 0, increase the index for more servers.
PCA_MEMCACHED_0_NAME=Localhost
PCA_MEMCACHED_0_HOST=127.0.0.1
PCA_MEMCACHED_0_PORT=11211
# Unix domain socket (optional, replaces host/port).
#PCA_MEMCACHED_0_PATH=/var/run/memcached/memcached.sock
# Separator for the tree view (optional).
#PCA_MEMCACHED_0_SEPARATOR=:
# Use the Memcached extension only for get and set operations (optional).
#PCA_MEMCACHED_0_EXTENSION=true

# === APCu ===
# Separator for the tree view (optional).
PCA_APCU_SEPARATOR=:

# === OPCache ===
# Directories the warmup may compile from, as a JSON array. Defaults to the document root.
#PCA_OPCACHE_WARMUPPATHS=["/var/www"]

# === Access ===
# Block every destructive action - deleting, editing, consoles (default false).
#PCA_READONLY=true
# Remove the Redis and Memcached consoles (default true).
PCA_CONSOLE=true
# There is no authentication until at least one user is defined, as a JSON object.
# Prefer a password_hash() hash over a plain password, this file is readable by everything that runs as the web server.
# php -r 'echo password_hash("your-password", PASSWORD_DEFAULT);'
#PCA_AUTHUSERS={"admin":"$2y$12$P0cd4reZNLtVAzCQ3J9C8udGtTId/pZIKU5ZUIPcvZTL9zW3CU58a"}
# Token for the metrics cronjob, only used when auth is enabled. Generate a long random one, e.g. `php -r "echo bin2hex(random_bytes(32));"`.
#PCA_AUTHTOKEN=

# === Security ===
# Send CSP, X-Frame-Options, X-Content-Type-Options and Referrer-Policy (default true).
PCA_SECURITYHEADERS=true

# === Customizations ===
# Leave unset to detect the timezone automatically.
#PCA_TIMEZONE=Europe/Bratislava
PCA_TIMEFORMAT="d. m. Y H:i:s"
PCA_DECIMALSEP=,
PCA_THOUSANDSSEP=" "
# Default key list view: table or tree.
PCA_LISTVIEW=table
# Open the key view in a modal instead of a separate page.
PCA_KEYMODAL=false
# Above this many keys a column sort only orders the page on screen, sorting them all would need too much memory.
# 0 disables the limit.
PCA_SORTTHRESHOLD=100000
# Refresh interval for panels, in seconds.
PCA_PANELREFRESH=30
# Refresh interval for metrics, in seconds.
PCA_METRICSREFRESH=60
# Default metrics tab: 1h, 1d, 1w or 1m.
PCA_METRICSTAB=1d
# Sampling interval for the live mode toggle in metrics, in seconds (1-60).
PCA_LIVEREFRESH=2
# How long the collected metrics are kept, in days. 0 keeps everything.
PCA_METRICSMAXAGE=30
# Any random string to secure a metrics DB file.
PCA_HASH=pca
# These default to "tmp", "tmp/metrics" and "tmp/twig" next to index.php. config.dist.php resolves them relative to
# itself, which an environment variable cannot do, so set them only if you want them somewhere else - with a full path.
#PCA_TMPDIR=/var/www/html/tmp
#PCA_METRICSDIR=/var/www/html/tmp/metrics
#PCA_TWIGCACHE=/var/www/html/tmp/twig
# Path to the package when installed via composer, used for assets.
#PCA_PCAPATH=vendor/robinn/phpcacheadmin/
# URL to the dashboard when installed via composer, e.g., /phpcacheadmin
#PCA_URL=/

# === Docker / PHP ===
# Not configuration options, these are read directly from the environment.
# Increase the PHP memory limit (Docker).
#PCA_PHP_MEMORY_LIMIT=256M
# Change the NGINX port (Docker).
#PCA_NGINX_PORT=80
