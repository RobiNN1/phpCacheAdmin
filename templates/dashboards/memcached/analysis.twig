{% import 'components/macros.twig' as macros %}
{#
    A card with a table of grouped rows. columns: [{title, field, format: number|bytes|share|text, class}]
#}
{% macro table_card(title, description, rows, columns, scroll = false) %}
    {% import 'components/macros.twig' as macros %}
    {% set cell = 'py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700' %}
    <div class="p-4 card flex flex-col mb-4 xl:mb-0{{ scroll ? ' h-128' : '' }}">
        <h2 class="mb-1 text-sm font-bold uppercase text-primary-900 dark:text-primary-400">{{ title }}</h2>
        <p class="mb-3 text-xs text-gray-600 dark:text-gray-300">{{ description }}</p>
        <div class="overflow-auto grow">
            <table class="w-full text-left table-auto dark:text-gray-300">
                <thead class="sticky top-0 z-10 bg-white dark:bg-gray-800">
                <tr class="border-b border-gray-200 dark:border-gray-700 text-primary-900 dark:text-primary-400">
                    {% for column in columns %}
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap {{ column.class|default('') }}">{{ column.title }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr class="hover:bg-gray-50 dark:hover:bg-white/5">
                        {% for column in columns %}
                            {% set value = attribute(row, column.field) %}
                            {% if column.format == 'share' %}
                                <td class="{{ cell }}">
                                    <div class="flex gap-2 items-center">
                                        <div class="grow">{{ macros.progress(value, 'lower', null, 'info') }}</div>
                                        <span class="shrink-0 text-xs text-gray-600 dark:text-gray-300">{{ value }}%</span>
                                    </div>
                                </td>
                            {% elseif column.format == 'number' %}
                                <td class="{{ cell }} whitespace-nowrap">{{ value|number }}</td>
                            {% elseif column.format == 'bytes' %}
                                <td class="{{ cell }} whitespace-nowrap">{{ value|bytes }}</td>
                            {% else %}
                                <td class="{{ cell }} break-all">{{ value }}</td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr><td colspan="{{ columns|length }}" class="{{ cell }} text-center text-gray-500">No data.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endmacro %}

{% if sizes %}
    <div class="p-4 card mb-4">
        <h2 class="mb-1 text-sm font-bold uppercase text-primary-900 dark:text-primary-400">Item sizes</h2>
        <p class="mb-3 text-xs text-gray-600 dark:text-gray-300">
            {% if sizes.enabled %}
                Counted by the server for every item in the cache, so this is not a sample.
                A class holds everything up to its size, and the size includes the key and the item overhead,
                which is why nothing lands in the smallest classes.
            {% else %}
                The server does not track item sizes. Start it with <code>-o track_sizes</code> to see the
                distribution of every item in the cache here.
            {% endif %}
        </p>

        {% if sizes.enabled %}
            <div class="overflow-auto max-h-96">
                <table class="w-full text-left table-auto dark:text-gray-300">
                    <thead class="sticky top-0 z-10 bg-white dark:bg-gray-800">
                    <tr class="border-b border-gray-200 dark:border-gray-700 text-primary-900 dark:text-primary-400">
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap">Size class</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-20">Items</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-40">Share</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in sizes.rows %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/5">
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.name|number }} B</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.count|number }}</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700">
                                <div class="flex gap-2 items-center">
                                    <div class="grow">{{ macros.progress(row.percent, 'lower', null, 'info') }}</div>
                                    <span class="shrink-0 text-xs text-gray-600 dark:text-gray-300">{{ row.percent }}%</span>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="py-2 px-4 text-sm text-center border-t border-gray-200 dark:text-gray-300 dark:border-gray-700">There are no items in the cache.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr class="text-gray-600 dark:text-gray-300">
                        <td class="py-2 px-4 text-xs font-semibold uppercase border-t border-gray-200 dark:border-gray-700">Total</td>
                        <td class="py-2 px-4 text-xs font-semibold border-t border-gray-200 dark:border-gray-700 whitespace-nowrap">{{ sizes.total|number }}</td>
                        <td class="border-t border-gray-200 dark:border-gray-700"></td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        {% endif %}
    </div>
{% endif %}

{% if tab_message %}
    <div class="p-4 card text-center text-gray-600 dark:text-gray-300">{{ tab_message }}</div>
{% elseif analysis is empty %}
    <div class="p-4 card text-center text-gray-600 dark:text-gray-300">There are no keys to analyze.</div>
{% else %}
    {% set summary = analysis.summary %}

    <div class="grid grid-cols-2 gap-4 mb-4 md:grid-cols-3 xl:grid-cols-5">
        {% for tile in analysis.tiles %}
            <div class="p-4 card">
                <h3 class="text-xs font-bold uppercase text-primary-900 dark:text-primary-400">{{ tile.label }}</h3>
                <p class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">{{ tile.value }}</p>
                <p class="mt-1 text-xs text-gray-600 dark:text-gray-300">{{ tile.note }}</p>
            </div>
        {% endfor %}
    </div>

    <div class="gap-4 xl:grid xl:grid-cols-2">
        <div class="p-4 card flex flex-col h-128 mb-4 xl:mb-0">
            <h2 class="mb-1 text-sm font-bold uppercase text-primary-900 dark:text-primary-400">Memory by namespace</h2>
            <p class="mb-3 text-xs text-gray-600 dark:text-gray-300">Top {{ analysis.namespaces|length }} of {{ summary.namespaces|number }} namespaces, by memory used.</p>
            <div class="overflow-auto grow">
                <table class="w-full text-left table-auto dark:text-gray-300">
                    <thead class="sticky top-0 z-10 bg-white dark:bg-gray-800">
                    <tr class="border-b border-gray-200 dark:border-gray-700 text-primary-900 dark:text-primary-400">
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap">Namespace</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-20">Keys</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-24">Memory</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-40">Share</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in analysis.namespaces %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/5">
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 break-all">{{ row.name }}</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.count|number }}</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.memory|bytes }}</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700">
                                <div class="flex gap-2 items-center">
                                    <div class="grow">{{ macros.progress(row.percent, 'lower', null, 'info') }}</div>
                                    <span class="shrink-0 text-xs text-gray-600 dark:text-gray-300">{{ row.percent }}%</span>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="p-4 card flex flex-col h-128 mb-4 xl:mb-0">
            <h2 class="mb-1 text-sm font-bold uppercase text-primary-900 dark:text-primary-400">Biggest keys</h2>
            <p class="mb-3 text-xs text-gray-600 dark:text-gray-300">The keys that use the most memory, including item overhead.</p>
            <div class="overflow-auto grow">
                <table class="w-full text-left table-auto dark:text-gray-300">
                    <thead class="sticky top-0 z-10 bg-white dark:bg-gray-800">
                    <tr class="border-b border-gray-200 dark:border-gray-700 text-primary-900 dark:text-primary-400">
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap">Key</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-24">Memory</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in analysis.top_memory %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/5">
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 break-all">
                                <a href="{{ link([], {view: 'key', key: row.key}) }}" class="font-semibold text-primary-500 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-500">{{ row.key }}</a>
                            </td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.size|bytes }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {{ _self.table_card('Keys by namespace', 'Top ' ~ analysis.namespaces_count|length ~ ' of ' ~ summary.namespaces|number ~ ' namespaces, by number of keys.', analysis.namespaces_count, [
            {title: 'Namespace', field: 'name', format: 'text'},
            {title: 'Keys', field: 'count', format: 'number', class: 'w-20'},
            {title: 'Memory', field: 'memory', format: 'bytes', class: 'w-24'},
            {title: 'Share', field: 'percent', format: 'share', class: 'w-40'},
        ], true) }}

        {{ _self.table_card('Key sizes', 'Every key in the dump by its size, including the key and the item overhead. Unlike the item sizes above, it needs no -o track_sizes.', analysis.sizes, [
            {title: 'Size', field: 'name', format: 'text'},
            {title: 'Keys', field: 'count', format: 'number', class: 'w-20'},
            {title: 'Memory', field: 'memory', format: 'bytes', class: 'w-24'},
            {title: 'Share', field: 'percent', format: 'share', class: 'w-40'},
        ]) }}

        <div class="p-4 card mb-4 xl:mb-0">
            <h2 class="mb-1 text-sm font-bold uppercase text-primary-900 dark:text-primary-400">Expiration</h2>
            <p class="mb-3 text-xs text-gray-600 dark:text-gray-300">When the keys are due to expire.</p>
            <div class="overflow-x-auto">
                <table class="w-full text-left table-auto dark:text-gray-300">
                    <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700 text-primary-900 dark:text-primary-400">
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap">Expires in</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-20">Keys</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-40">Share</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in analysis.expiry %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/5">
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.name }}</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.count|number }}</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700">
                                <div class="flex gap-2 items-center">
                                    <div class="grow">{{ macros.progress(row.percent, 'lower', null, 'info') }}</div>
                                    <span class="shrink-0 text-xs text-gray-600 dark:text-gray-300">{{ row.percent }}%</span>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="p-4 card mb-4 xl:mb-0">
            <h2 class="mb-1 text-sm font-bold uppercase text-primary-900 dark:text-primary-400">Last used</h2>
            <p class="mb-3 text-xs text-gray-600 dark:text-gray-300">How long ago the keys were last read. Memcached evicts the least recently used keys first.</p>
            <div class="overflow-x-auto">
                <table class="w-full text-left table-auto dark:text-gray-300">
                    <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700 text-primary-900 dark:text-primary-400">
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap">Last read</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-20">Keys</th>
                        <th class="py-2 px-4 text-xs font-bold uppercase whitespace-nowrap w-40">Share</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in analysis.idle %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/5">
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.name }} ago</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700 whitespace-nowrap">{{ row.count|number }}</td>
                            <td class="py-2 px-4 text-sm border-t border-gray-200 dark:text-gray-300 dark:border-gray-700">
                                <div class="flex gap-2 items-center">
                                    <div class="grow">{{ macros.progress(row.percent, 'lower', null, 'info') }}</div>
                                    <span class="shrink-0 text-xs text-gray-600 dark:text-gray-300">{{ row.percent }}%</span>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if analysis.classes is not empty %}
            {{ _self.table_card('Slab classes', 'Where the keys are stored, the share is of the memory in keys. Compare it with the Slabs tab to see which classes are full.', analysis.classes, [
                {title: 'Class', field: 'name', format: 'text', class: 'w-20'},
                {title: 'Keys', field: 'count', format: 'number', class: 'w-20'},
                {title: 'Memory', field: 'memory', format: 'bytes', class: 'w-24'},
                {title: 'Share', field: 'percent', format: 'share', class: 'w-40'},
            ], analysis.classes|length > 10) }}
        {% endif %}

        {% if analysis.flags is not empty %}
            {{ _self.table_card('Client flags', 'The flags the client libraries stored the keys with, explained as the PHP memcached extension sets them.', analysis.flags, [
                {title: 'Flags', field: 'name', format: 'text', class: 'w-20'},
                {title: 'Meaning', field: 'meaning', format: 'text'},
                {title: 'Keys', field: 'count', format: 'number', class: 'w-20'},
                {title: 'Share', field: 'percent', format: 'share', class: 'w-40'},
            ]) }}
        {% endif %}
    </div>
{% endif %}
