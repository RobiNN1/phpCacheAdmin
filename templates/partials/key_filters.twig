{#
    Search and filters of a key list, the data comes from KeyFilters::view() as key_filters.
#}
{% set f = key_filters %}
{% set field_class = 'py-1.5 px-3 text-sm bg-white rounded border border-gray-300 focus:outline-hidden focus:ring-3 focus:ring-primary-200 focus:border-primary-300
    dark:text-white dark:bg-gray-800 dark:border-gray-600 dark:focus:ring-primary-500 dark:focus:border-primary-400' %}
{% set label_class = 'block mb-1 text-xs font-semibold text-gray-600 dark:text-gray-300' %}

<details class="border-t border-gray-200 dark:border-gray-700"{{ f.open ? ' open' : '' }}>
    <summary class="py-2 px-6 text-sm font-semibold text-gray-600 cursor-pointer select-none dark:text-gray-300">
        Filters
        {% if f.matching is not null and f.partial %}
            <span class="font-normal text-gray-500 dark:text-gray-400"
                  title="The keys are listed with SCAN, which stops at the scan size (the scansize option, 1000 by default). There can be more matching keys.">· first {{ f.matching|number }} matching</span>
        {% elseif f.matching is not null %}
            <span class="font-normal text-gray-500 dark:text-gray-400">· {{ f.matching|number }} matching</span>
        {% endif %}
        {% if f.note %}
            <span class="font-normal text-gray-500 dark:text-gray-400">· {{ f.note }}</span>
        {% endif %}
    </summary>

    <form method="get" class="flex flex-wrap gap-3 items-end px-6 pb-4">
        {% for name, value in f.query %}
            <input type="hidden" name="{{ name }}" value="{{ value }}">
        {% endfor %}

        <div>
            <label for="filter_s" class="{{ label_class }}">Key</label>
            <div class="flex">
                <select id="filter_match" name="match" aria-label="Match" class="select py-1.5 px-3 pe-5 text-sm bg-white rounded-l border border-r-0 border-gray-300 appearance-none dark:text-white dark:bg-gray-800 dark:border-gray-600">
                    {% for value, name in f.modes %}
                        <option value="{{ value }}"{{ f.values.match == value ? ' selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
                <input id="filter_s" name="s" type="text" value="{{ f.values.s }}" placeholder="Search..." class="{{ field_class }} rounded-l-none w-56">
            </div>
        </div>

        {% if f.supported.type is defined %}
            <div>
                <label for="filter_type" class="{{ label_class }}">{{ f.labels.type }}</label>
                <select id="filter_type" name="type" class="select py-1.5 px-3 pe-8 text-sm bg-white rounded border border-gray-300 appearance-none dark:text-white dark:bg-gray-800 dark:border-gray-600">
                    <option value="">Any</option>
                    {% for value, name in f.types %}
                        <option value="{{ value }}"{{ f.values.type == value ? ' selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}

        {% for name in ['expin', 'idle'] %}
            {% if f.supported[name] is defined %}
                <div>
                    <label for="filter_{{ name }}" class="{{ label_class }}">{{ f.labels[name] }}</label>
                    <input id="filter_{{ name }}" name="{{ name }}" type="number" min="0" value="{{ f.values[name] ?: '' }}" class="{{ field_class }} w-36">
                </div>
            {% endif %}
        {% endfor %}

        {% if f.supported.minsize is defined %}
            <div>
                <span class="{{ label_class }}">{{ f.labels.minsize }}</span>
                <div class="flex gap-1 items-center">
                    <input name="minsize" type="number" min="0" value="{{ f.values.minsize ?: '' }}" placeholder="Min" aria-label="Minimum" class="{{ field_class }} w-24">
                    <span class="text-gray-400">–</span>
                    <input name="maxsize" type="number" min="0" value="{{ f.values.maxsize ?: '' }}" placeholder="Max" aria-label="Maximum" class="{{ field_class }} w-24">
                </div>
            </div>
        {% endif %}

        {% set checkboxes = ['nf', 'noexp']|filter(name => f.supported[name] is defined) %}
        {% if checkboxes is not empty %}
            {# Not macros.checkbox(), its negative margin aligns it in table rows and lifts it above the label here. #}
            <div class="flex flex-col gap-1.5">
                {% for name in checkboxes %}
                    <label class="inline-flex gap-2 items-center text-sm leading-none">
                        <input type="checkbox" id="filter_{{ name }}" name="{{ name }}" value="1"{{ f.values[name] ? ' checked' : '' }}
                               class="checkbox shrink-0 h-4 w-4 appearance-none rounded border border-gray-300 bg-white checked:border-primary-200 checked:bg-primary-500
                               focus:outline-hidden focus:ring-3 focus:ring-primary-200 dark:bg-gray-900 dark:border-gray-600 dark:checked:bg-primary-500 dark:focus:ring-primary-400">
                        {{ f.labels[name] }}
                    </label>
                {% endfor %}
            </div>
        {% endif %}

        <div class="flex gap-2">
            {{ include('components/button.twig', {text: 'Apply', icon: 'search', submit: true}) }}
            <a href="?{{ f.query|url_encode }}" class="inline-flex items-center py-1.5 px-3 text-sm font-semibold text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-white">Reset</a>
        </div>
    </form>

    {% if f.delete and f.matching and not readonly %}
        {% if f.partial %}
            {# Only the first matches are listed, but the button removes every matching key, say so. #}
            {% set text = f.delete ~ ' all matching ' ~ f.noun ~ 's (at least ' ~ f.matching|number ~ ')' %}
            {% set question = f.delete ~ ' every ' ~ f.noun ~ ' that matches the search and filters? That is at least ' ~ f.matching|number ~ ', the whole database is scanned for more. This cannot be undone.' %}
        {% else %}
            {% set noun = f.matching == 1 ? f.noun : f.noun ~ 's' %}
            {% set text = f.delete ~ ' ' ~ f.matching|number ~ ' matching ' ~ noun %}
            {% set question = f.delete ~ ' ' ~ f.matching|number ~ ' ' ~ noun ~ (f.matching == 1 ? ' that matches' : ' that match') ~ ' the search and filters? This cannot be undone.' %}
        {% endif %}
        <form method="post" class="px-6 pb-4">
            <input type="hidden" name="csrf_token" value="{{ csrf }}">
            {{ include('components/button.twig', {
                text: text,
                icon: 'trash',
                id: 'delete_matching',
                color: 'red',
                submit: true,
                attributes: {'data-confirm': question},
            }) }}
        </form>
    {% endif %}
</details>
